    {
        "id": "453d7379b0dffaa9",
        "type": "function",
        "z": "261c13a730e3d6cd",
        "name": "Validate Sensor Data",
        "func": "const data = msg.payload;\n\nif (\n    data.storeId &&\n    data.unitId &&\n    typeof data.temperature === \"number\" &&\n    data.doorStatus &&\n    data.compressorStatus &&\n    typeof data.powerUsageWatts === \"number\"\n) {\n    msg.valid = true;\n} else {\n    msg.valid = false;\n}\n\nreturn msg;\n",
